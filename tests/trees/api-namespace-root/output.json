{
  "description": "maps an api-namespace file at the base directory to the root path",
  "elements": [
    {
      "kind": "apiNamespace",
      "path": "/",
      "middlewareConfigFn": {
        "kind": "ref-call",
        "args": [
          {
            "importDefault": "RootApiNamespace",
            "from": "api-namespace.ts"
          }
        ]
      }
    }
  ]
}
