{
  "description": "doesn't support options, ignoring a sibling `options` file",
  "elements": [
    {
      "kind": "apiNamespace",
      "path": "/external",
      "middlewareConfigFn": {
        "kind": "ref-call",
        "args": [
          {
            "importDefault": "ExternalApiNamespace",
            "from": "external/api-namespace.ts"
          }
        ]
      }
    }
  ]
}
