{
  "description": "transforms a trailing `[...rest]` into a splat",
  "elements": [
    {
      "kind": "page",
      "component": {
        "kind": "ref-call",
        "args": [
          {
            "importDefault": "FilesPage",
            "from": "files/[...rest]/page.tsx"
          }
        ]
      }
    },
    {
      "kind": "route",
      "name": "FilesRoute",
      "path": "/files/*",
      "page": {
        "kind": "page",
        "component": {
          "kind": "ref-call",
          "args": [
            {
              "importDefault": "FilesPage",
              "from": "files/[...rest]/page.tsx"
            }
          ]
        }
      }
    }
  ]
}
