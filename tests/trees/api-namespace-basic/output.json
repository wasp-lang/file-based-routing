{
  "description": "creates an apiNamespace from an `api-namespace` file",
  "elements": [
    {
      "kind": "apiNamespace",
      "path": "/api",
      "middlewareConfigFn": {
        "kind": "ref-call",
        "args": [
          {
            "importDefault": "ApiApiNamespace",
            "from": "api/api-namespace.ts"
          }
        ]
      }
    }
  ]
}
