{
  "description": "doesn't interpret `[...rest]` as a splat when it is not the last path component",
  "elements": [
    {
      "kind": "page",
      "component": {
        "kind": "ref-call",
        "args": [
          {
            "importDefault": "FilesRestSubPage",
            "from": "files/[...rest]/sub/page.tsx"
          }
        ]
      }
    },
    {
      "kind": "route",
      "name": "FilesRestSubRoute",
      "path": "/files/:...rest/sub",
      "page": {
        "kind": "page",
        "component": {
          "kind": "ref-call",
          "args": [
            {
              "importDefault": "FilesRestSubPage",
              "from": "files/[...rest]/sub/page.tsx"
            }
          ]
        }
      }
    }
  ]
}
