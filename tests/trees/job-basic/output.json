{
  "description": "creates a job with the PgBoss executor by default",
  "elements": [
    {
      "kind": "job",
      "fn": {
        "kind": "ref-call",
        "args": [
          {
            "importDefault": "SendDigestJob",
            "from": "jobs/sendDigest.ts"
          }
        ]
      },
      "executor": "PgBoss"
    }
  ]
}
